{
  "schema_version": 1,
  "name": "scratch-selfplay-v1",
  "description": "All three phases from random weights against HHH and the current policy, then a new stage that adds historical snapshots, then fixed-opponent and head-to-head evaluations.",
  "output_root": "runs/pipelines/scratch-selfplay-v1",
  "steps": [
    {
      "id": "selfplay",
      "command": "train_selfplay_ppo",
      "args": {
        "from-scratch": true,
        "learner-bid": "neural-train",
        "learner-trump": "neural-train",
        "learner-play": "neural-train",
        "opponent-pool": "HHH:0.3,self-current:0.7",
        "eval-opponents": "HHH,CHH",
        "selection-opponent": "HHH",
        "total-hands": 131072,
        "rollout-decisions": 4096,
        "threads": 8,
        "seed": 42
      }
    },
    {
      "id": "historical",
      "command": "train_selfplay_ppo",
      "description": "New stage from the first stage's best.pt; opponents now include published snapshots.",
      "args": {
        "init-checkpoint": "${selfplay.best}",
        "learner-bid": "neural-train",
        "learner-trump": "neural-train",
        "learner-play": "neural-train",
        "opponent-pool": "HHH:0.2,self-current:0.3,self-snapshots:0.5",
        "eval-opponents": "HHH,CHH",
        "selection-opponent": "HHH",
        "snapshot-every-hands": 16384,
        "snapshot-pool-size": 8,
        "total-hands": 131072,
        "rollout-decisions": 4096,
        "threads": 8,
        "seed": 43
      }
    },
    {
      "id": "fixed-opponents",
      "command": "evaluate_selfplay_ppo",
      "args": {
        "checkpoint": "${historical.best}",
        "opponents": "HHH,CHH,HHR",
        "deals": 2048,
        "seed": 12345,
        "threads": 8
      }
    },
    {
      "id": "head-to-head",
      "command": "evaluate_agent_vs_agent",
      "args": {
        "agent-a-checkpoint": "${historical.best}",
        "agent-a-bid": "neural",
        "agent-a-trump": "neural",
        "agent-a-play": "neural",
        "agent-b-checkpoint": "${selfplay.best}",
        "agent-b-bid": "neural",
        "agent-b-trump": "neural",
        "agent-b-play": "neural",
        "deals": 2048,
        "seed": 7355608,
        "threads": 8
      }
    }
  ]
}